{
  "version": "1.0",
  "sources": [
    "model"
  ],
  "outputDirectory": "build/output",
  "projections": {
    "open-api-gateway": {
      "plugins": {
        "openapi": {
          "service": "uk.co.motorway#CarApi",
          "apiGatewayDefaults": "2023-08-11"
        }
      }
    },
    "open-api": {
      "transforms": [
        {
          "name": "excludeTraits",
          "args": {
            "traits": [
              "aws.apigateway#integration"
            ]
          }
        }
      ],
      "plugins": {
        "openapi": {
          "service": "uk.co.motorway#CarApi",
          "apiGatewayDefaults": "2023-08-11"
        }
      }
    },
    "ts-server": {
      "transforms": [
        {
          "name": "excludeShapesByTag",
          "args": {
            "tags": [
              "client-only"
            ]
          }
        },
        {
          "name": "includeServices",
          "args": {
            "services": [
              "uk.co.motorway#CarApi"
            ]
          }
        }
      ],
      "plugins": {
        "typescript-server-codegen": {
          "service": "uk.co.motorway#CarApi",
          "package": "car-api",
          "packageVersion": "0.0.1"
        }
      }
    }
  },
  "maven": {
    "dependencies": [
      "software.amazon.smithy.typescript:smithy-aws-typescript-codegen:0.26.0",
      "software.amazon.smithy:smithy-aws-apigateway-openapi:1.54.0",
      "software.amazon.smithy:smithy-aws-traits:1.54.0",
      "software.amazon.smithy:smithy-cli:1.54.0",
      "software.amazon.smithy:smithy-model:1.54.0",
      "software.amazon.smithy:smithy-openapi:1.54.0",
      "software.amazon.smithy:smithy-validation-model:1.54.0"
    ]
  }
}